# Data — keep structure, but don't commit large/raw data by default
data/raw/*
!data/raw/.gitkeep
data/database/*.sqlite
data/database/*.db

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# OS
.DS_Store
Thumbs.db

# Outputs
outputs/models/*
!outputs/models/.gitkeep

# Archives & Temporary files
*.zip

# Power BI (binary, large)
dashboard/*.pbix
